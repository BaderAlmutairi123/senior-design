# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (phishing simulation emails)
# Get a key at https://resend.com
# For dev/demo use the sandbox sender onboarding@resend.dev (sends to your Resend account email only)
RESEND_API_KEY=re_...
PHISHING_FROM_EMAIL=onboarding@resend.dev
